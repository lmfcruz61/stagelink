msgid "Mensagem"
msgstr "Mensaje"

#: .\templates\streams\room.html:17
msgid "Gorjeta"
msgstr "Propina"

#: .\templates\streams\room.html:33
msgid "Escreve no chat"
msgstr "Escribe en el chat"

#: .\templates\streams\room.html:34
msgid "Enviar"
msgstr "Enviar"

#: .\templates\streams\room.html:41
msgid ""
"Não foi possível carregar este vídeo. Confirma o ID ou link do YouTube no "
"dashboard do artista."
msgstr ""

#: .\templates\streams\room.html:42
msgid ""
"Este vídeo bloqueia incorporação fora do YouTube. No YouTube Studio, ativa a "
"incorporação ou usa uma live pública/não listada que permita embed."
msgstr ""

#: .\templates\streams\room.html:43
msgid ""
"O ID/link do YouTube não parece válido ou o vídeo não está público/"
"disponível."
msgstr ""

#: .\templates\streams\room.html:44
msgid "Chat ligado."
msgstr "Chat conectado."

#: .\templates\streams\room.html:45
msgid "Erro ao ligar o chat."
msgstr "Error al conectar el chat."

#: .\templates\streams\room.html:46
msgid "Chat desligado."
msgstr "Chat desconectado."

#: .\templates\streams\room.html:47
msgid "O chat ainda não está ligado. Recarrega a página."
msgstr ""


